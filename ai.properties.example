# 复制本文件为 ai.properties，填入你的密钥后即可使用「AI 建议标签」。
#
# 安全提醒：
#   1. ai.properties 已在 .gitignore 中，绝不要提交到 Git；
#   2. 只需要填 key；换厂商改 base-url 与 model 即可（都支持 OpenAI 兼容接口）。
#
# 也可以改用环境变量（优先级高于本文件）：
#   set AI_API_KEY=sk-xxxx
#   set AI_BASE_URL=https://api.deepseek.com
#   set AI_MODEL=deepseek-chat

key=sk-在这里填你的密钥

# DeepSeek（默认）
base-url=https://api.deepseek.com
model=deepseek-chat

# 通义千问（DashScope 兼容模式）
# base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
# model=qwen-plus

# 智谱 GLM
# base-url=https://open.bigmodel.cn/api/paas/v4
# model=glm-4-flash

# OpenAI
# base-url=https://api.openai.com/v1
# model=gpt-4o-mini

# 可选参数
temperature=0.3
max-tokens=300
timeout-seconds=60
